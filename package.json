{
  "private": true,
  "name": "remix-app-template",
  "description": "",
  "license": "",
  "scripts": {
    "build": "cross-env NODE_ENV=production npm run build:css && remix build",
    "build:css": "tailwindcss -i ./app/styles/styles.css -o ./app/styles/tailwind.css --minify",
    "dev": "concurrently \"npm run dev:css\" \"remix dev\"",
    "dev:css": "tailwindcss -i ./app/styles/styles.css -o ./app/styles/tailwind.css --watch",
    "start": "remix-serve build"
  },
  "dependencies": {
    "@remix-run/node": "^1.19.0",
    "@remix-run/react": "^1.19.3",
    "@remix-run/serve": "^1.19.0",
    "@remix-run/v1-route-convention": "^0.1.4",
    "@remix-run/vercel": "^1.19.0",
    "date-fns": "^2.28.0",
    "dotenv": "^10.0.0",
    "front-matter": "^4.0.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "redis": "^4.0.0",
    "remark-gfm": "^3.0.1",
    "remix": "^1.0.6",
    "tiny-invariant": "^1.2.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^1.4.0",
    "@tailwindcss/aspect-ratio": "^0.4.0",
    "@tailwindcss/typography": "^0.5.1",
    "@types/react": "^17.0.24",
    "@types/react-dom": "^17.0.9",
    "@types/redis": "^2.8.32",
    "autoprefixer": "^10.4.2",
    "concurrently": "^6.4.0",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.6",
    "prettier": "^2.5.0",
    "stylelint-config-recommended": "^6.0.0",
    "tailwindcss": "^3.0.18",
    "typescript": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
